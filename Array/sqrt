class Solution {
    public int mySqrt(int x) {
        if (x < 2)
            return x;

        long left = 1;
        long right = x / 2;
        int ans = 0;

        while (left <= right) {
            long mid = (left + right) / 2;

            if (mid * mid <= x) {
                ans = (int) mid;
                left = mid + 1;
            } else {
                right = mid - 1;
            }
        }

        return ans;
    }
}
